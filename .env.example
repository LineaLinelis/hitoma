# 実値は .dev.vars（git対象外）または wrangler secret put に設定。
# VITE_ で始めない。ブラウザーに秘密鍵を出さない。
WORLD_APP_ID=app_your_app_id
WORLD_RP_ID=rp_your_rp_id
WORLD_RP_SIGNING_KEY=your_server_only_rp_signing_key
SESSION_SECRET=your_random_secret_at_least_32_characters
# 管理APIを使う場合だけ設定。未設定なら管理操作は拒否。
ADMIN_SECRET=your_random_admin_secret_at_least_32_characters
# 公開先のオリジンを完全一致で指定。末尾スラッシュなし。
APP_ORIGIN=https://hitoma.your-subdomain.workers.dev
