{
  "name": "hitoma",
  "private": true,
  "version": "0.1.0",
  "description": "Anonymous text-only bulletin board with World ID Proof of Human verification on Cloudflare Workers and D1.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/LineaLinelis/hitoma.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview": "wrangler dev --ip 0.0.0.0 --port 8787",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "node scripts/preflight.mjs && npm run build && wrangler deploy",
    "check:deploy": "node scripts/preflight.mjs"
  },
  "dependencies": {
    "@noble/hashes": "1.8.0",
    "@noble/secp256k1": "2.3.0",
    "@worldcoin/idkit": "4.4.0",
    "@worldcoin/idkit-core": "4.4.0",
    "lucide-react": "1.52.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261005.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "esbuild": "^0.25.12",
    "jsonc-parser": "^3.3.1",
    "miniflare": "4.20260730.0",
    "playwright-core": "^1.55.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "vitest": "^3.2.0",
    "wrangler": "4.147.0"
  }
}
